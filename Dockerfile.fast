# syntax=docker/dockerfile:1.7

# Copy-only Dockerfile. No compilation; binaries come from the workflow's
# matrix build job. Drastically faster than rebuilding from source.
#
# Phase 3-5 cutover (2026-05-22): the build context's ./prebuilt-bins/
# directory now contains exactly ONE real binary (`hawcx-manager`) plus
# 8 symlinks under legacy names (haap-authenticator, haap-tqs-precompute,
# haap-tqs-jit, haap-assembler, haap-eib, haap-supervisor, haap-sdk,
# haap-unseal-orch).
#
# 2026-09-04: `haap-unseal-orch` is the 8th, and it is load-bearing rather
# than a compatibility alias. `haap-supervisor` spawns the §35.4 unseal
# orchestrator by a name it resolves itself — `[orchestrator] orch_bin`,
# then a sibling of its own binary, then $PATH — and in this image all
# three land in /usr/local/bin. Without the symlink none of them hit: the
# published v0.1.4 image carried the orchestrator's code (a non-optional
# dependency of haap-supervisor, linked in) with no way to reach it, so
# the daemon could not start. Asserted against the pushed image by
# scripts/check-image-orch-target.py.
# The symlinks are generated by the matrix-build job's `Stage Docker
# binaries` step BEFORE the docker-bins artifact is uploaded, so they
# arrive here intact. `COPY` preserves symlink structure.
#
# See /hx_agent_canonical_spec/DESIGN-MEMO-MULTICALL-BINARY.md for the
# argv0 dispatch design.

# 2026-09-04: this base has no libdbus, and does not need one — do NOT
# add one. The published v0.1.4 image died at the dynamic linker on
# EVERY entrypoint (`libdbus-1.so.3: cannot open shared object file`,
# exit 127, 8/8, no Rust code ever reached) because it pinned
# hawcx-manager 0.8.8, which linked the `keyring` crate's
# secret-service backend. Upstream now takes keyring with
# `default-features = false` + `linux-native` (the kernel keyutils
# backend, no dbus), so 0.11.8 — the version release.yml pins as of
# #112 — links only libc/libgcc_s/libm, all three present here.
#
# Measured on real arm64 containers, holding this Dockerfile constant
# and varying ONLY the binary in prebuilt-bins/:
#   0.8.8  -> exit 127, libdbus-1.so.3 missing
#   0.11.8 -> exit 0, `hawcx-manager 0.11.8`
#
# So the libdbus symptom is fixed by the version pin, not by adding
# libraries. Copying libdbus-1.so.3 and its 7 transitive libs
# (libsystemd, libgcrypt, libcap, liblzma, libzstd, liblz4,
# libgpg-error) in from a debian stage would add CVE surface for a
# dependency the shipped binary does not have. release.yml's per-arch
# `Smoke test` step already owns the drift class: it runs the pushed
# image and asserts the exact version string, which a linker failure
# cannot produce.
FROM gcr.io/distroless/cc-debian12

LABEL org.opencontainers.image.source="https://github.com/hawcx/hawcx_agentic_sdk"
LABEL org.opencontainers.image.description="HAAP SDK runtime (hawcx-manager multi-call binary + 8 legacy-name symlinks; haap-rsv ships from ghcr.io/hawcx/haap-rsv)"

# 2026-05-21: haap-rsv removed from this image. The MCP-server-side
# verifier sidecar ships from hx_agent_authorizer/Dockerfile as a
# separate image at ghcr.io/hawcx/haap-rsv. Customers who run the
# verifier alongside the supervisor pull both images.
#
# 2026-05-22 (Phase 3-5): single COPY of the pre-staged tree replaces
# the prior 7 per-binary COPY lines. Symlinks are made at packaging
# time on the matrix runner (release.yml `Stage Docker binaries`),
# not here.
COPY prebuilt-bins/ /usr/local/bin/

# Default entrypoint = haap-supervisor (symlink to hawcx-manager);
# argv[0] routes to supervisor mode via the multi-call dispatcher.
ENTRYPOINT ["/usr/local/bin/haap-supervisor"]
